#-----------------------------------------------------------------------------
# SoCLabs Ethernet MAC AHB — SpyGlass CDC Waivers
#
# Suppress CDC violations originating entirely within third-party IP.
# SoCLabs-authored RTL (src/rtl/**) should NEVER be waived here —
# add targeted waivers with justification comments instead.
#
# Contributors
#
# David Mapstone (d.a.mapstone@soton.ac.uk)
#
# Copyright 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------

# ============================================================================
# Third-party IP: OpenCores Ethernet MAC (eth_top and submodules)
# ============================================================================
# The OpenCores Ethernet MAC has known CDC crossings between the WB/system
# clock and the MII TX/RX clocks.  These are internal to the IP and have
# been in production use for years.  Waive to focus on SoCLabs wrapper CDC.

waive -rule "*" -du {eth_top}              -comment "third-party-IP"
waive -rule "*" -du {eth_clockgen}         -comment "third-party-IP"
waive -rule "*" -du {eth_cop}              -comment "third-party-IP"
waive -rule "*" -du {eth_crc}              -comment "third-party-IP"
waive -rule "*" -du {eth_fifo}             -comment "third-party-IP"
waive -rule "*" -du {eth_maccontrol}       -comment "third-party-IP"
waive -rule "*" -du {eth_macstatus}        -comment "third-party-IP"
waive -rule "*" -du {eth_miim}             -comment "third-party-IP"
waive -rule "*" -du {eth_outputcontrol}    -comment "third-party-IP"
waive -rule "*" -du {eth_random}           -comment "third-party-IP"
waive -rule "*" -du {eth_receivecontrol}   -comment "third-party-IP"
waive -rule "*" -du {eth_register}         -comment "third-party-IP"
waive -rule "*" -du {eth_registers}        -comment "third-party-IP"
waive -rule "*" -du {eth_rxaddrcheck}      -comment "third-party-IP"
waive -rule "*" -du {eth_rxcounters}       -comment "third-party-IP"
waive -rule "*" -du {eth_rxethmac}         -comment "third-party-IP"
waive -rule "*" -du {eth_rxstatem}         -comment "third-party-IP"
waive -rule "*" -du {eth_shiftreg}         -comment "third-party-IP"
waive -rule "*" -du {eth_transmitcontrol}  -comment "third-party-IP"
waive -rule "*" -du {eth_txcounters}       -comment "third-party-IP"
waive -rule "*" -du {eth_txethmac}         -comment "third-party-IP"
waive -rule "*" -du {eth_txstatem}         -comment "third-party-IP"
waive -rule "*" -du {eth_wishbone}         -comment "third-party-IP"
waive -rule "*" -du {eth_spram_256x32}     -comment "third-party-IP"

# ============================================================================
# Third-party IP: OpenCores HA1588 (PTP timestamp unit)
# ============================================================================
# HA1588 has internal CDC between rtc_clk and the WB/system clock.
# The patched modules (ha1588, rtc, reg, ptp_queue) retain the original
# CDC architecture.

waive -rule "*" -du {ha1588}               -comment "third-party-IP"
waive -rule "*" -du {rtc}                  -comment "third-party-IP"
waive -rule "*" -du {ptp_parser}           -comment "third-party-IP"
waive -rule "*" -du {ptp_queue}            -comment "third-party-IP"
waive -rule "*" -du {tsu}                  -comment "third-party-IP"
waive -rule "*" -du {reg}                  -comment "third-party-IP"
waive -rule "*" -du {wb_slv_wrapper}       -comment "third-party-IP"

# ============================================================================
# Third-party IP: ARM CMSDK
# ============================================================================

waive -rule "*" -du {cmsdk_fpga_sram}      -comment "third-party-IP"
waive -rule "*" -du {cmsdk_apb_slave_mux}  -comment "third-party-IP"

# ============================================================================
# Third-party IP: AMBA/WISHBONE Bridges
# ============================================================================
# Bridge IP is single-clock (operates in system clock domain).

waive -rule "*" -du {ahb3lite_to_wb}       -comment "third-party-IP"
waive -rule "*" -du {wb_to_ahb3lite}       -comment "third-party-IP"
waive -rule "*" -du {apb_to_wb}            -comment "third-party-IP"
